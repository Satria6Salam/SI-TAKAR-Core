DATABASE_URL=sqlite:///./si_takar.db

# Kota/kabupaten lokasi pasar seni (dipakai untuk menentukan warga "lokal" di MLQ)
# GANTI sesuai lokasi pasar yang sebenarnya
DOMISILI_PASAR=Kota Contoh

# Parameter deadlock (sesuai keputusan Ketua)
TIMEOUT_HARI=3
PREEMPTION_HARI=14
PERINGATAN_HARI=7

# Timer background: cek deadlock tiap N detik (0 = nonaktif)
CRON_INTERVAL_DETIK=60

# ---- Autentikasi Admin (JWT) ----
# WAJIB diganti dengan string acak panjang sebelum production!
# Cara buat: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GANTI_INI_SEBELUM_PRODUCTION_guna_string_acak_panjang

# Masa berlaku JWT token admin (dalam menit)
ACCESS_TOKEN_EXPIRE_MENIT=60

# Kode undangan untuk pendaftaran akun admin baru
# Ganti dengan nilai acak rahasia dan jangan bagikan ke publik
ADMIN_REGISTRATION_KEY=GANTI_DENGAN_KODE_UNDANGAN_RAHASIA
