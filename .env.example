DATABASE_URL=sqlite:///./si_takar.db

# Kota/kabupaten lokasi pasar seni (dipakai untuk menentukan warga "lokal" di MLQ)
# GANTI sesuai lokasi pasar yang sebenarnya
DOMISILI_PASAR=Kabupaten Malang

# Parameter deadlock (sesuai keputusan Ketua)
TIMEOUT_HARI=3
PERINGATAN_HARI=7
PREEMPTION_HARI=14
# Sekian kali timeout -> pendaftaran gugur
MAKS_TIMEOUT=3

# Lama satu siklus sewa (hari)
SEWA_HARI=180

# Aging: pendaftar Queue 2/3 yang menunggu selama ini naik satu tingkat (0 = nonaktif)
AGING_HARI=0

# Pembagian lapak: manual = per putaran alokasi yang dijalankan admin (MLQ benar-benar berlaku);
# langsung = dibagikan seketika saat pendaftar siap
PUTARAN_ALOKASI=manual

# Mode manual: putaran otomatis sekali sehari mulai jam ini (WIB); -1 = hanya lewat tombol admin
PUTARAN_HARIAN_JAM=7

# Pernah dicabut / gugur dalam sekian hari -> prioritas turun satu tingkat saat daftar ulang (0 = nonaktif)
PENALTI_HARI=180

# Pendaftar baru menunggu verifikasi dokumen (KTP) oleh admin sebelum masuk antrean (1 = ya)
VERIFIKASI_WAJIB=1

# Folder penyimpanan unggahan KTP dan bukti status khusus (tetap di laptop)
UNGGAHAN_DIR=./unggahan

# Timer background: cek deadlock tiap N detik (0 = nonaktif)
CRON_INTERVAL_DETIK=60

# Isi zona contoh + akun admin demo otomatis saat database masih kosong (1 = ya)
AUTO_SEED=1

# Opsional. Jika kosong, sesi admin berakhir setiap server dimulai ulang.
ADMIN_SESSION_SECRET=
